FROM netboxcommunity/netbox:v4.2

# Install paramiko into the venv via get-pip.py bootstrap
RUN /opt/netbox/venv/bin/python3 -c "import urllib.request; urllib.request.urlretrieve('https://bootstrap.pypa.io/get-pip.py', '/tmp/get-pip.py')" && \
    /opt/netbox/venv/bin/python3 /tmp/get-pip.py && \
    /opt/netbox/venv/bin/python3 -m pip install paramiko && \
    rm /tmp/get-pip.py

# Copy SSH validator (used when SSH_VALIDATION_ENABLED=true)
# NOTE: Do NOT overwrite extras/webhooks.py - the original NetBox send_webhook
# must remain intact for the RQ worker to process webhook jobs correctly.
COPY netbox/extras/ssh_validator.py /opt/netbox/netbox/extras/ssh_validator.py
RUN chown unit:root /opt/netbox/netbox/extras/ssh_validator.py
